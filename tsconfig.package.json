{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,

    "incremental": false
  },
  "include": [
    "index.ts",
    "icons/**/*.ts",
    "icons/**/*.tsx",
    "core/**/*.ts",
    "core/**/*.tsx"
  ],
  "exclude": ["node_modules", "app", "components"]
}
